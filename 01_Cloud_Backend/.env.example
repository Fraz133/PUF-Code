# ============================================================
# PUF Backend Environment Configuration
# ============================================================
# Copy this file and rename to .env on your server
# Then fill in your MongoDB Atlas connection string
# ============================================================

# MongoDB Atlas Connection String
# Get this from: Atlas Dashboard > Database > Connect > Drivers > Python
# Replace USERNAME, PASSWORD, and CLUSTER with your actual values
MONGO_URL=mongodb+srv://puf_admin:YOUR_PASSWORD_HERE@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
